---
import { Image } from "astro:assets";
import type { MarkdownInstance } from "astro";

import Layout from "../layouts/Layout.astro";

// Images
import circleProfile from "../images/circle-profile.png";

interface Frontmatter {
  title: string;
  description: string;
  date: string;
  status: string;
}

const posts = Object.values(
  import.meta.glob<MarkdownInstance<Frontmatter>>("./blog/*.md", {
    eager: true,
  }),
);
---

<Layout title="Lachlan MacPhee">
  <main class="grid h-full grid-cols-1 md:grid-cols-2">
    <div class="h-full space-y-8 p-4 md:px-8 md:py-10">
      <div
        class="grid grid-cols-1 items-center sm:grid-cols-[160px,1fr] sm:gap-8"
      >
        <Image
          class="w-40 justify-self-center sm:justify-normal"
          alt="A picture of me, Lachlan MacPhee."
          src={circleProfile}
        />
        <div class="space-y-1 text-center sm:text-left">
          <h1 class="text-5xl font-bold">Lachlan MacPhee</h1>
          <h2 class="mb-4 text-lg sm:mb-8">
            I'm a problem solver with a passion for people.
          </h2>
        </div>
      </div>
      <div>
        <h3 class="mb-2 text-3xl font-bold">About Me</h3>
        <p class="mb-4">
          Hey there! My name's Lachlan. I'm on a mission to leave a lasting
          positive impact on this world through my work and relationships.
        </p>
        <p class="mb-4">
          I have a keen eye for detail and like to ensure things are done once
          and done properly. Outside of my work life, I love meeting new people,
          competing in triathlons, tinkering with electronics, cooking healthy
          meals, and working on passion projects.
        </p>
        <p>
          If you'd like to get in touch, please <a
            href="mailto:contact@lachlanmacphee.com"
            ><span class="font-extrabold underline">send me an email</span></a
          > or <a href="https://www.linkedin.com/in/lachlanmacphee/"
            ><span class="font-extrabold underline"
              >connect with me on LinkedIn</span
            ></a
          >
        </p>
      </div>
      <div>
        <h3 class="mb-4 mt-8 text-3xl font-bold">Blog Posts</h3>
        <ol class="list-none space-y-1">
          {
            posts
              .filter((post) => post.frontmatter.status == "published")
              .reverse()
              .map((post) => (
                <li>
                  <a class="font-bold underline" href={post.url}>
                    {post.frontmatter.date}: {post.frontmatter.title}
                  </a>
                </li>
              ))
          }
        </ol>
      </div>
    </div>
    <div class="h-full p-4 md:px-8 md:py-10">
      <div class="max-w-lg">
        <h3 class="mb-4 text-3xl font-bold">Projects</h3>
        <div class="grid grid-cols-1 gap-3">
          <div>
            <a href="https://github.com/eddiroot/eddi"
              ><h4 class="text-xl font-bold underline">eddi</h4></a
            >
            <p>
              My pride and joy. A software project I'm working on with uni
              friends to reimagine how schools teach and organise.
            </p>
          </div>
          <div>
            <a href="https://github.com/lachlanmacphee/runclub"
              ><h4 class="text-xl font-bold underline">runclub</h4></a
            >
            <p>Enhancing my local running club's timing and operations.</p>
          </div>
          <div>
            <a href="https://tursim.lachlanmacphee.com"
              ><h4 class="text-xl font-bold underline">tursim</h4></a
            >
            <p>A turing machine simulator written to replace Tuatara.</p>
          </div>
          <div>
            <a href="https://tbh.lachlanmacphee.com"
              ><h4 class="text-xl font-bold underline">
                the better handbook
              </h4></a
            >
            <p>
              An open-source handbook and review platform for Monash University.
            </p>
          </div>
          <div>
            <a href="https://github.com/lachlanmacphee/launtsched"
              ><h4 class="text-xl font-bold underline">launtsched</h4></a
            >
            <p>
              Change settings of your Launtel service/s through the command
              line.
            </p>
          </div>
          <div>
            <a href="https://github.com/lachlanmacphee/scroom"
              ><h4 class="text-xl font-bold underline">scroom</h4></a
            >
            <p>A scrum-based project management tool for agile teams.</p>
          </div>
          <div>
            <a
              href="https://github.com/lachlanmacphee/cidio/blob/main/brief.pdf"
              ><h4 class="text-xl font-bold underline">cidio</h4></a
            >
            <p>Helping university students find subjects that fit them.</p>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>
