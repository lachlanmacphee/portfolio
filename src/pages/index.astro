---
import type { MarkdownInstance } from "astro";
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";

// Images
import circleProfile from "../images/circle-profile.png";

interface Frontmatter {
  title: string;
  description: string;
  date: string;
  status: string;
}

const posts = Object.values(
  import.meta.glob<MarkdownInstance<Frontmatter>>("./blog/*.md", {
    eager: true,
  })
);
---

<Layout title="Lachlan MacPhee">
  <main class="flex justify-center p-6 md:p-8">
    <div class="h-full max-w-2xl space-y-8">
      <div class="grid grid-cols-1 items-center">
        <Image
          class="justify-self-center"
          width="160"
          height="160"
          alt="A picture of me, Lachlan MacPhee."
          src={circleProfile}
        />
        <div class="mt-4 space-y-1 text-center">
          <h1 class="text-5xl font-bold">Lachlan MacPhee</h1>
          <h2 class="mb-4 text-lg">
            A problem solver with a passion for people.
          </h2>
        </div>
      </div>
      <!-- About Me -->
      <div>
        <h3 class="mb-2 text-3xl font-bold">About Me</h3>
        <p class="mb-4">
          Hey there! My name's Lachlan. I'm on a mission to leave a lasting
          positive impact on this world through my work and relationships.
        </p>
        <p class="mb-4">
          I have a keen eye for detail and like to ensure things are done once
          and done properly. Outside of my work life, I love meeting new people,
          running long distances, having a crack at triathlons, tinkering with
          electronics, cooking healthy meals, and working on passion projects.
        </p>
        <p>
          If you'd like to get in touch, please <a
            href="mailto:contact@lachlanmacphee.com"
            ><span class="font-extrabold underline">send me an email</span></a
          > or <a href="https://www.linkedin.com/in/lachlanmacphee/"
            ><span class="font-extrabold underline"
              >connect with me on LinkedIn</span
            ></a
          >
        </p>
      </div>
      <!-- Blog Posts -->
      <div>
        <h3 class="mb-4 mt-8 text-3xl font-bold">Blog Posts</h3>
        <table class="w-full">
          <caption class="sr-only">List of blog posts</caption>
          <colgroup>
            <col />
            <col class="w-32" />
          </colgroup>
          <thead class="sr-only">
            <tr>
              <th scope="col">Title & Description</th>
              <th scope="col">Date</th>
            </tr>
          </thead>
          <tbody>
            {
              posts
                .filter((post) => post.frontmatter.status == "published")
                .reverse()
                .map((post) => (
                  <tr class="border border-black">
                    <td class="border-r border-black p-2">
                      <a
                        class="text-lg font-semibold underline"
                        href={post.url}
                      >
                        {post.frontmatter.title}
                      </a>
                      <p class="text-sm">{post.frontmatter.description}</p>
                    </td>
                    <td class="text-center">{post.frontmatter.date}</td>
                  </tr>
                ))
            }
          </tbody>
        </table>
      </div>
      <!-- Projects -->
      <div>
        <h3 class="mb-4 text-3xl font-bold">Projects</h3>
        <table class="w-full">
          <caption class="sr-only">List of projects</caption>
          <colgroup>
            <col />
            <col class="w-32" />
          </colgroup>
          <thead class="sr-only">
            <tr>
              <th scope="col">Project & Description</th>
              <th scope="col">Link</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border border-black">
              <td class="border-r border-black p-2">
                <span class="text-lg font-semibold">eddi</span>
                <p class="text-sm">
                  A software project I'm working on with uni friends to
                  reimagine schooling.
                </p>
              </td>
              <td class="text-center">
                <a
                  class="font-bold underline"
                  href="https://github.com/eddiroot/eddi">GitHub</a
                >
              </td>
            </tr>
            <tr class="border border-black">
              <td class="border-r border-black p-2">
                <span class="text-lg font-semibold">runclub</span>
                <p class="text-sm">
                  Enhancing my local running club's timing and operations.
                </p>
              </td>
              <td class="text-center">
                <a
                  class="font-bold underline"
                  href="https://github.com/lachlanmacphee/runclub">GitHub</a
                >
              </td>
            </tr>
            <tr class="border border-black">
              <td class="border-r border-black p-2">
                <span class="text-lg font-semibold">tursim</span>
                <p class="text-sm">
                  A turing machine simulator written to replace Tuatara.
                </p>
              </td>
              <td class="text-center">
                <a
                  class="font-bold underline"
                  href="https://tursim.lachlanmacphee.com">Website</a
                >
              </td>
            </tr>
            <tr class="border border-black">
              <td class="border-r border-black p-2">
                <span class="text-lg font-semibold">the better handbook</span>
                <p class="text-sm">
                  An open-source handbook and review platform for Monash
                  University.
                </p>
              </td>
              <td class="text-center">
                <a
                  class="font-bold underline"
                  href="https://tbh.lachlanmacphee.com">Website</a
                >
              </td>
            </tr>
            <tr class="border border-black">
              <td class="border-r border-black p-2">
                <span class="text-lg font-semibold">launtsched</span>
                <p class="text-sm">
                  Change settings of your Launtel service/s through the command
                  line.
                </p>
              </td>
              <td class="text-center">
                <a
                  class="font-bold underline"
                  href="https://github.com/lachlanmacphee/launtsched">GitHub</a
                >
              </td>
            </tr>
            <tr class="border border-black">
              <td class="border-r border-black p-2">
                <span class="text-lg font-semibold">scroom</span>
                <p class="text-sm">
                  A scrum-based project management tool for agile teams.
                </p>
              </td>
              <td class="text-center">
                <a
                  class="font-bold underline"
                  href="https://github.com/lachlanmacphee/scroom">GitHub</a
                >
              </td>
            </tr>
            <tr class="border border-black">
              <td class="border-r border-black p-2">
                <span class="text-lg font-semibold">cidio</span>
                <p class="text-sm">
                  Helping university students find subjects that fit them.
                </p>
              </td>
              <td class="text-center">
                <a
                  class="font-bold underline"
                  href="https://github.com/lachlanmacphee/cidio/blob/main/brief.pdf"
                  >Brief</a
                >
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</Layout>
