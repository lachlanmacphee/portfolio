---
import type { MarkdownInstance } from "astro";
import { Image } from "astro:assets";

import Layout from "../layouts/Layout.astro";

// Images
import ProfilePic from "../images/profile.jpeg";

interface Frontmatter {
  title: string;
  description: string;
  date: string;
  status: string;
}

const posts = Object.values(
  import.meta.glob<MarkdownInstance<Frontmatter>>("./blog/*.md", {
    eager: true,
  }),
);
---

<Layout title="Lachlan MacPhee">
  <main class="flex justify-center p-6 md:p-8">
    <div class="h-full max-w-2xl space-y-8">
      <!-- Picture and Headline -->
      <div class="grid grid-cols-1 items-center rounded-2xl p-4">
        <Image
          class="h-40 w-40 justify-self-center rounded-full"
          width={800}
          height={800}
          alt="A picture of me, Lachlan MacPhee."
          src={ProfilePic}
        />
        <div class="mt-4 flex flex-col items-center text-center">
          <h1 class="text-4xl font-bold sm:text-5xl">Lachlan MacPhee</h1>
          <h2 class="mt-2 max-w-72 text-lg sm:max-w-none">
            I'm a problem solver with a passion for people.
          </h2>
        </div>
      </div>
      <!-- About Me -->
      <div>
        <h3 class="mb-2 text-3xl font-bold">About Me</h3>
        <p class="mb-4">
          Hey there! My name's Lachlan. I'm a software engineer on a mission to
          leave a lasting positive impact on this world through my work and
          relationships.
        </p>
        <p class="mb-4">
          I have a keen eye for detail and like to ensure things are done once
          and done properly. Outside of my work life, I love meeting new people,
          running long distances, having a crack at triathlons, tinkering with
          electronics, cooking healthy meals, and working on passion projects.
        </p>
        <p>
          If you'd like to get in touch, please <a
            href="mailto:contact@lachlanmacphee.com"
            ><span class="font-extrabold underline">send me an email</span></a
          > or <a href="https://www.linkedin.com/in/lachlanmacphee/"
            ><span class="font-extrabold underline"
              >connect with me on LinkedIn</span
            ></a
          >
        </p>
      </div>
      <!-- Blog Posts -->
      <div>
        <h3 class="mt-8 mb-4 text-3xl font-bold">Blog Posts</h3>
        <table class="w-full">
          <caption class="sr-only">List of blog posts</caption>
          <colgroup>
            <col />
            <col class="w-32" />
          </colgroup>
          <thead class="sr-only">
            <tr>
              <th scope="col">Title & Description</th>
              <th scope="col">Date</th>
            </tr>
          </thead>
          <tbody>
            {
              posts
                .filter((post) => post.frontmatter.status == "published")
                .reverse()
                .map((post) => (
                  <tr>
                    <td class="p-2">
                      <a
                        class="text-lg font-semibold underline"
                        href={post.url}
                      >
                        {post.frontmatter.title}
                      </a>
                      <p class="text-sm">{post.frontmatter.description}</p>
                    </td>
                    <td class="text-center">{post.frontmatter.date}</td>
                  </tr>
                ))
            }
          </tbody>
        </table>
      </div>
      <!-- Projects -->
      <div>
        <h3 class="mb-4 text-3xl font-bold">Projects</h3>
        <table class="w-full">
          <caption class="sr-only">List of projects</caption>
          <colgroup>
            <col />
            <col class="w-32" />
          </colgroup>
          <thead class="sr-only">
            <tr>
              <th scope="col">Project & Description</th>
              <th scope="col">Status</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="p-2">
                <a
                  class="text-lg font-semibold underline"
                  target="_blank"
                  href="https://eddi.com.au">eddi</a
                >
                <p class="text-sm">
                  A software project I'm working on that reimagines schooling.
                </p>
              </td>
              <td class="text-center">
                <span class="font-bold">Active</span>
              </td>
            </tr>
            <tr>
              <td class="p-2">
                <a
                  class="text-lg font-semibold underline"
                  target="_blank"
                  href="https://github.com/lachlanmacphee/runclub">runclub</a
                >
                <p class="text-sm">
                  Enhancing my local running club's timing and operations.
                </p>
              </td>
              <td class="text-center">
                <span class="font-bold">Maintained</span>
              </td>
            </tr>
            <tr>
              <td class="p-2">
                <a
                  class="text-lg font-semibold underline"
                  target="_blank"
                  href="https://tursim.lachlanmacphee.com">tursim</a
                >
                <p class="text-sm">
                  A turing machine simulator written to replace Tuatara.
                </p>
              </td>
              <td class="text-center">
                <span class="font-bold">Maintained</span>
              </td>
            </tr>
            <tr>
              <td class="p-2">
                <a
                  class="text-lg font-semibold underline"
                  target="_blank"
                  href="https://thebetterhandbook.com.au">the better handbook</a
                >
                <p class="text-sm">
                  An open-source handbook and review platform for Australian
                  Universities.
                </p>
              </td>
              <td class="text-center">
                <span class="font-bold">Maintained</span>
              </td>
            </tr>
            <tr>
              <td class="p-2">
                <a
                  class="text-lg font-semibold underline"
                  target="_blank"
                  href="https://github.com/lachlanmacphee/launtsched"
                  >launtsched</a
                >
                <p class="text-sm">
                  Change settings of your Launtel service/s through the command
                  line.
                </p>
              </td>
              <td class="text-center">
                <span class="font-bold">Maintained</span>
              </td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </main>
</Layout>
